{
	"name": "greenpeace/planet4-test-leda",
	"description": "Greenpeace P4 test-leda",
	"license": "MIT",
	"require": {
		"greenpeace/planet4-master-theme": "7",
		"wpackagist-plugin/elasticpress": "5.3.3"
	},
	"extra": {
		"wp-version": "7.0.2"
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "greenpeace/planet4-master-theme",
				"type": "wordpress-theme",
				"autoload": {
					"psr-4": {
						"P4\\MasterTheme\\": "src/"
					}
				},
				"extra": null,
				"version": 7,
				"dist": {
					"type": "zip",
					"url": "https://storage.googleapis.com/planet4-packages/planet4-master-theme/487944994fe4a81050b97c75f6d1ca37d462bbe0.zip"
				}
			}
		}
	]
}
